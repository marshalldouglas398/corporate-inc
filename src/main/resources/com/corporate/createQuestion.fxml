<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="760.0" prefWidth="1200.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.controllers.CreateQuestionController">
   <top>
      <HBox alignment="CENTER_LEFT" prefHeight="78.0" spacing="14.0" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="14.0" left="20.0" right="20.0" top="14.0" />
         </padding>
         <children>
            <Label text="Corporate Code" />
            <Region HBox.hgrow="ALWAYS" />
            <Button fx:id="backButton" mnemonicParsing="false" onAction="#back" text="Back" />
         </children>
      </HBox>
   </top>
   <center>
      <VBox fx:id="createQuestionContent" spacing="14.0">
         <padding>
            <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
         </padding>
         <children>
            <Label fx:id="pageTitleLabel" text="Create Question" />
            <VBox fx:id="metadataSection" spacing="10.0">
               <padding>
                  <Insets bottom="14.0" left="14.0" right="14.0" top="14.0" />
               </padding>
               <children>
                  <Label text="Question Metadata; Stick to one per category for now, later you can add more" />
                  <HBox spacing="10.0">
                     <children>
                        <VBox spacing="6.0" HBox.hgrow="ALWAYS">
                           <children>
                              <Label text="Title" />
                              <TextField fx:id="questionTitleField" promptText="Enter question title" />
                           </children>
                        </VBox>
                        <VBox prefWidth="220.0" spacing="6.0">
                           <children>
                              <Label text="Difficulty" />
                              <TextField fx:id="questionDifficultyField" promptText="EASY / MEDIUM / HARD" />
                           </children>
                        </VBox>
                     </children>
                  </HBox>
                  <HBox spacing="10.0">
                     <children>
                        <VBox spacing="6.0" HBox.hgrow="ALWAYS">
                           <children>
                              <Label text="Question Type" />
                              <TextField fx:id="questionTypeField" promptText="TECHNICAL / BEHAVIORAL / CONCEPTUAL" />
                           </children>
                        </VBox>
                        <VBox spacing="6.0" HBox.hgrow="ALWAYS">
                           <children>
                              <Label text="Tag" />
                              <TextField fx:id="questionTagsField" promptText="Comma-separated QuestionTag values" />
                           </children>
                        </VBox>
                     </children>
                  </HBox>
                  <HBox spacing="10.0">
                     <children>
                        <VBox spacing="6.0" HBox.hgrow="ALWAYS">
                           <children>
                              <Label text="Discipline" />
                              <TextField fx:id="questionDisciplinesField" promptText="COMPSCI, COMPENG, CYBERSEC, DATASCI" />
                           </children>
                        </VBox>
                        <VBox spacing="6.0" HBox.hgrow="ALWAYS">
                           <children>
                              <Label text="Course" />
                              <TextField fx:id="questionCoursesField" promptText="CSCE145, CSCE146, CSCE240, CSCE247, CSCE350" />
                           </children>
                        </VBox>
                     </children>
                  </HBox>
                  <HBox alignment="CENTER_LEFT" spacing="10.0">
                     <children>
                        <CheckBox fx:id="interviewModeCheckBox" mnemonicParsing="false" text="Interview Mode" />
                        <Label text="Time Limit (minutes)" />
                        <TextField fx:id="interviewTimeField" prefWidth="180.0" promptText="e.g. 45" />
                     </children>
                  </HBox>
               </children>
            </VBox>
            <VBox fx:id="statementSection" spacing="8.0">
               <padding>
                  <Insets bottom="14.0" left="14.0" right="14.0" top="14.0" />
               </padding>
               <children>
                  <Label text="Problem Statement" />
                  <TextArea fx:id="questionDescriptionArea" prefHeight="170.0" promptText="Describe the question prompt and constraints..." wrapText="true" />
               </children>
            </VBox>
            <VBox fx:id="hintsSection" spacing="10.0">
               <padding>
                  <Insets bottom="14.0" left="14.0" right="14.0" top="14.0" />
               </padding>
               <children>
                  <Label text="Hints" />
                  <TextField fx:id="questionHintOneField" promptText="Hint 1" />
                  <TextField fx:id="questionHintTwoField" promptText="Hint 2" />
                  <TextField fx:id="questionHintThreeField" promptText="Hint 3" />
               </children>
            </VBox>
            <VBox fx:id="sectionsBuilderSection" spacing="10.0">
               <padding>
                  <Insets bottom="14.0" left="14.0" right="14.0" top="14.0" />
               </padding>
               <children>
                  <HBox alignment="CENTER_LEFT" spacing="10.0">
                     <children>
                        <Label text="Sections" />
                        <Region HBox.hgrow="ALWAYS" />
                     </children>
                  </HBox>
                  <Label fx:id="sectionInstructionsLabel" text="Use Add Section to add a section to the question." wrapText="true" />
                  <VBox fx:id="sectionsContainer" spacing="12.0">
                     <children>
                        <VBox fx:id="sectionCardOne" spacing="8.0">
                           <padding>
                              <Insets bottom="12.0" left="12.0" right="12.0" top="12.0" />
                           </padding>
                           <children>
                              <Label text="Section " />
                              <TextField fx:id="sectionOneTitleField" promptText="Section title" />
                              <TextArea fx:id="sectionOneDescriptionArea" prefHeight="100.0" promptText="Section description" wrapText="true" />
                              <TextField fx:id="sectionOneFileField" promptText="Attached file name/path (optional)" />
                              <TextArea fx:id="sectionOneCodeArea" prefHeight="120.0" promptText="Code/content for this section" wrapText="true" />
                           </children>
                        </VBox>
                        <VBox fx:id="sectionCardTwoPlaceholder" spacing="8.0">
                           <padding>
                              <Insets bottom="12.0" left="12.0" right="12.0" top="12.0" />
                           </padding>
                        </VBox>
                     </children>
                  </VBox>
               </children>
            </VBox>
            <HBox fx:id="actionsRow" alignment="CENTER_RIGHT" spacing="10.0">
               <children>
                  <Region HBox.hgrow="ALWAYS" />
                  <Button fx:id="addSectionButton" mnemonicParsing="false" onAction="#addSection" text="+ Add Section" />
                  <Button fx:id="cancelButton" mnemonicParsing="false" onAction="#back" text="Back" />
                  <Button fx:id="saveButton" mnemonicParsing="false" onAction="#saveQuestion" text="Save Question" />
               </children>
            </HBox>
         </children>
      </VBox>
   </center>
   <stylesheets>
      <URL value="@styles.css" />
   </stylesheets>
</BorderPane>
