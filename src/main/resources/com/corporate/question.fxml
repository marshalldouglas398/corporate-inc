<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="760.0" prefWidth="1200.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.controllers.QuestionController">
   <top>
      <HBox alignment="CENTER_LEFT" prefHeight="78.0" spacing="16.0" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="14.0" left="20.0" right="20.0" top="14.0" />
         </padding>
         <children>
            <Label text="Corporate Code" />
            <Region HBox.hgrow="ALWAYS" />
            <Button fx:id="h_btn" mnemonicParsing="false" onAction="#goToDashboard" text="Home" />
            <Button fx:id="srch_btn" mnemonicParsing="false" onAction="#goToSearch" text="Search" />
            <Button fx:id="logout_btn" mnemonicParsing="false" onAction="#logout" text="Logout" />
            <Button fx:id="stg_btn" mnemonicParsing="false" onAction="#goToSettings" text="Settings" />
         </children>
      </HBox>
   </top>
   <center>
      <HBox prefHeight="680.0" prefWidth="1200.0" spacing="18.0">
         <padding>
            <Insets bottom="18.0" left="20.0" right="20.0" top="18.0" />
         </padding>
         <children>
            <VBox fx:id="leftColumn" spacing="14.0" HBox.hgrow="ALWAYS">
               <children>
                  <Label fx:id="questionTitleLabel" text="Two Sum" />
                  <HBox spacing="8.0">
                     <children>
                        <Label fx:id="qTypeLabel" text="Technical" />
                        <Label fx:id="qTagLabel" text="Write Code" />
                        <Label fx:id="difficultyLabel" text="Easy" />
                     </children>
                  </HBox>
                  <VBox fx:id="problemCard" spacing="10.0">
                     <padding>
                        <Insets bottom="14.0" left="14.0" right="14.0" top="14.0" />
                     </padding>
                     <children>
                        <HBox alignment="CENTER_LEFT" spacing="8.0">
                           <children>
                              <Label text="Problem Description" />
                              <Region HBox.hgrow="ALWAYS" />
                              <Label text="Rate" />
                              <Label text="3.75/5" />
                           </children>
                        </HBox>
                        <Label fx:id="q_desc_label" text="Given an array of integers nums and an integer target, return indices of the two numbers that add up to target. There is exactly one solution, and you may not use the same element twice." wrapText="true" />
                        <Label text="Examples" />
                        <VBox spacing="10.0">
                           <children>
                              <VBox spacing="4.0">
                                 <children>
                                    <Label text="Input nums = [2, 7, 11, 15], target = 9" wrapText="true" />
                                    <Label text="Output [0, 1]" />
                                    <Label text="Explanation Because nums[0] + nums[1] == 9, we return [0, 1]." wrapText="true" />
                                 </children>
                              </VBox>
                              <VBox spacing="4.0">
                                 <children>
                                    <Label text="Input nums = [3, 2, 4], target = 6" wrapText="true" />
                                    <Label text="Output [1, 2]" />
                                    <Label text="Explanation Because nums[1] + nums[2] == 6, we return [1, 2]." wrapText="true" />
                                 </children>
                              </VBox>
                           </children>
                        </VBox>
                     </children>
                  </VBox>
                  <VBox fx:id="hintsCard" spacing="8.0">
                     <padding>
                        <Insets bottom="14.0" left="14.0" right="14.0" top="14.0" />
                     </padding>
                     <children>
                        <Label text="Hints" />
                        <Label text="Hint 1" />
                        <Label text="Try using a hash table to store values you've seen." wrapText="true" />
                        <Label text="Hint 2" />
                        <Label text="Hint 3" />
                     </children>
                  </VBox>
               </children>
            </VBox>
            <VBox fx:id="rightColumn" prefWidth="560.0" spacing="14.0">
               <children>
                  <VBox fx:id="responseCard" spacing="10.0">
                     <padding>
                        <Insets bottom="14.0" left="14.0" right="14.0" top="14.0" />
                     </padding>
                     <children>
                        <Label text="Your Response" />
                        <TextArea fx:id="responseArea" prefHeight="170.0" promptText="Type your answer here" wrapText="true" />
                        <HBox spacing="8.0">
                           <children>
                              <Button fx:id="add_sec_btn" mnemonicParsing="false" text="+ Add Section" />
                              <Button fx:id="add_t_btn" mnemonicParsing="false" text="+ Add Tag" />
                              <Region HBox.hgrow="ALWAYS" />
                              <Button fx:id="sub_com_btn" mnemonicParsing="false" text="Submit Comment" />
                           </children>
                        </HBox>
                     </children>
                  </VBox>
                  <VBox fx:id="commentsCard" spacing="10.0" VBox.vgrow="ALWAYS">
                     <padding>
                        <Insets bottom="14.0" left="14.0" right="14.0" top="14.0" />
                     </padding>
                     <children>
                        <HBox alignment="CENTER_LEFT">
                           <children>
                              <Label text="Comments" />
                              <Region HBox.hgrow="ALWAYS" />
                              <Label text="Comment Filters" />
                           </children>
                        </HBox>
                        <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS">
                           <content>
                              <VBox spacing="12.0">
                                 <padding>
                                    <Insets bottom="8.0" left="4.0" right="4.0" top="8.0" />
                                 </padding>
                                 <children>
                                    <VBox spacing="6.0">
                                       <children>
                                          <Label text="sparrow   SOLUTION   04-03-26   Rating 4/5" />
                                          <Label text="Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua." wrapText="true" />
                                          <HBox spacing="8.0">
                                             <children>
                                                <Button fx:id="rep_com_btn" mnemonicParsing="false" text="Reply" />
                                                <Button fx:id="rate_com_btn" mnemonicParsing="false" text="Rate" />
                                             </children>
                                          </HBox>
                                          <Label text="End of comment section" />
                                       </children>
                                    </VBox>
                                 </children>
                              </VBox>
                           </content>
                        </ScrollPane>
                     </children>
                  </VBox>
               </children>
            </VBox>
         </children>
      </HBox>
   </center>
   <stylesheets>
      <URL value="@styles.css" />
   </stylesheets>
</BorderPane>
