<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="760.0" prefWidth="1200.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.controllers.QuestionController">
   <top>
      <HBox alignment="CENTER_LEFT" prefHeight="78.0" spacing="16.0" styleClass="header" stylesheets="@questionstyles.css" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="14.0" left="20.0" right="20.0" top="14.0" />
         </padding>
         <children>
            <ImageView fitHeight="60.0" fitWidth="93.0" pickOnBounds="true" preserveRatio="true">
               <image>
                  <Image url="@images/corporatelogo-new.png" />
               </image>
            </ImageView>
            <Label styleClass="corporate-header" stylesheets="@questionstyles.css" text="Corporate Code" />
            <Region prefHeight="70.0" prefWidth="0.0" stylesheets="@questionstyles.css" HBox.hgrow="ALWAYS" />
            <Button fx:id="h_btn" mnemonicParsing="false" onAction="#goToDashboard" styleClass="create-question-header-button" stylesheets="@questionstyles.css">
               <graphic>
                  <ImageView fitHeight="59.0" fitWidth="58.0" pickOnBounds="true" preserveRatio="true">
                     <image>
                        <Image url="@images/Home.png" />
                     </image>
                  </ImageView>
               </graphic></Button>
            <Button fx:id="srch_btn" mnemonicParsing="false" onAction="#goToSearch" styleClass="create-question-header-button" stylesheets="@questionstyles.css">
               <graphic>
                  <ImageView fitHeight="56.0" fitWidth="63.0" pickOnBounds="true" preserveRatio="true">
                     <image>
                        <Image url="@images/search_btn.png" />
                     </image>
                  </ImageView>
               </graphic></Button>
            <Button fx:id="logout_btn" mnemonicParsing="false" onAction="#logout" styleClass="create-question-header-button" stylesheets="@questionstyles.css">
               <graphic>
                  <ImageView fitHeight="59.0" fitWidth="69.0" pickOnBounds="true" preserveRatio="true">
                     <image>
                        <Image url="@images/Log%20out.png" />
                     </image>
                  </ImageView>
               </graphic></Button>
            <Button fx:id="stg_btn" mnemonicParsing="false" onAction="#goToSettings" styleClass="create-question-header-button" stylesheets="@questionstyles.css">
               <graphic>
                  <ImageView fitHeight="60.0" fitWidth="57.0" pickOnBounds="true" preserveRatio="true">
                     <image>
                        <Image url="@images/Settings.png" />
                     </image>
                  </ImageView>
               </graphic></Button>
         </children>
      </HBox>
   </top>
   <center>
      <HBox prefHeight="680.0" prefWidth="1200.0" spacing="18.0" styleClass="question-page" stylesheets="@questionstyles.css">
         <padding>
            <Insets bottom="18.0" left="20.0" right="20.0" top="18.0" />
         </padding>
         <children>
            <VBox fx:id="leftColumn" spacing="14.0" styleClass="sections-background" stylesheets="@questionstyles.css" HBox.hgrow="ALWAYS">
               <children>
                  <Label fx:id="questionTitleLabel" styleClass="header-text" stylesheets="@questionstyles.css" text="Loading question..." />
                  <HBox spacing="8.0">
                     <children>
                        <Label fx:id="qTypeLabel" text="" />
                        <Label fx:id="qTagLabel" text="" />
                        <Label fx:id="difficultyLabel" text="" />
                     </children>
                  </HBox>
                  <VBox fx:id="problemCard" spacing="10.0">
                     <padding>
                        <Insets bottom="14.0" left="14.0" right="14.0" top="14.0" />
                     </padding>
                     <children>
                        <HBox alignment="CENTER_LEFT" spacing="8.0">
                           <children>
                              <Label styleClass="sections-labels" stylesheets="@questionstyles.css" text="Problem Description" />
                              <Region HBox.hgrow="ALWAYS" />
                              <Button fx:id="rate_question_btn" mnemonicParsing="false" onAction="#rateQuestion" styleClass="action-button" stylesheets="@questionstyles.css" text="Rate" />
                              <Label fx:id="questionRatingLabel" text="-" />
                           </children>
                        </HBox>
                        <Label fx:id="q_desc_label" styleClass="question-content-text" stylesheets="@questionstyles.css" text="" wrapText="true" />
                        <Label styleClass="sections-labels" stylesheets="@questionstyles.css" text="Examples" />
                        <VBox fx:id="examplesContainer" spacing="10.0">
                           <children>
                              <Label styleClass="sections-labels" stylesheets="@questionstyles.css" text="No examples available." />
                           </children>
                        </VBox>
                     </children>
                  </VBox>
                  <VBox fx:id="hintsCard" spacing="8.0">
                     <padding>
                        <Insets bottom="14.0" left="14.0" right="14.0" top="14.0" />
                     </padding>
                     <children>
                        <Label styleClass="sections-labels" stylesheets="@questionstyles.css" text="Hints" />
                        <VBox fx:id="hintsContainer" spacing="6.0" />
                     </children>
                  </VBox>
               </children>
            </VBox>
            <VBox fx:id="rightColumn" prefWidth="560.0" spacing="14.0">
               <children>
                  <VBox fx:id="responseCard" spacing="10.0">
                     <padding>
                        <Insets bottom="14.0" left="14.0" right="14.0" top="14.0" />
                     </padding>
                     <children>
                        <Label styleClass="sections-labels" stylesheets="@questionstyles.css" text="Your Response" />
                        <TextArea fx:id="responseArea" prefHeight="170.0" promptText="Type your answer here" wrapText="true" />
                        <HBox spacing="8.0">
                           <children>
                              <Button fx:id="add_sec_btn" mnemonicParsing="false" onAction="#addSectionDraft" styleClass="action-button" stylesheets="@questionstyles.css" text="+ Add Section" />
                              <Button fx:id="add_t_btn" mnemonicParsing="false" onAction="#addTagDraft" styleClass="action-button" stylesheets="@questionstyles.css" text="+ Add Tag" />
                              <Region HBox.hgrow="ALWAYS" />
                              <Button fx:id="sub_com_btn" mnemonicParsing="false" onAction="#submitComment" styleClass="action-button" stylesheets="@questionstyles.css" text="Submit Comment" />
                           </children>
                        </HBox>
                        <Label fx:id="replyingToLabel" text="" visible="false" />
                        <Label text="Draft Sections" />
                        <VBox fx:id="draftSectionsContainer" spacing="6.0" />
                        <Label text="Draft Tags" />
                        <VBox fx:id="draftTagsContainer" spacing="6.0" />
                     </children>
                  </VBox>
                  <VBox fx:id="commentsCard" spacing="10.0" VBox.vgrow="ALWAYS">
                     <padding>
                        <Insets bottom="14.0" left="14.0" right="14.0" top="14.0" />
                     </padding>
                     <children>
                        <HBox alignment="CENTER_LEFT">
                           <children>
                              <Label styleClass="sections-labels" stylesheets="@questionstyles.css" text="Comments" />
                              <Region HBox.hgrow="ALWAYS" />
                              <ComboBox fx:id="commentFilterBox" onAction="#onCommentFilterChanged" prefWidth="170.0" promptText="Comment Filters" />
                           </children>
                        </HBox>
                        <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS">
                           <content>
                              <VBox fx:id="commentsContainer" spacing="12.0">
                                 <padding>
                                    <Insets bottom="8.0" left="4.0" right="4.0" top="8.0" />
                                 </padding>
                              </VBox>
                           </content>
                        </ScrollPane>
                     </children>
                  </VBox>
               </children>
            </VBox>
         </children>
      </HBox>
   </center>
   <stylesheets>
      <URL value="@styles.css" />
   </stylesheets>
</BorderPane>
