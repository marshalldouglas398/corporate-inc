<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="760.0" prefWidth="1200.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.controllers.QuestionController">
   <top>
      <HBox alignment="CENTER_LEFT" prefHeight="78.0" spacing="16.0" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="14.0" left="20.0" right="20.0" top="14.0" />
         </padding>
         <children>
            <Label text="Corporate Code" />
            <Region HBox.hgrow="ALWAYS" />
            <Button fx:id="h_btn" mnemonicParsing="false" onAction="#goToDashboard" text="Home" />
            <Button fx:id="srch_btn" mnemonicParsing="false" onAction="#goToSearch" text="Search" />
            <Button fx:id="logout_btn" mnemonicParsing="false" onAction="#logout" text="Logout" />
            <Button fx:id="stg_btn" mnemonicParsing="false" onAction="#goToSettings" text="Settings" />
         </children>
      </HBox>
   </top>
   <center>
      <HBox prefHeight="680.0" prefWidth="1200.0" spacing="18.0">
         <padding>
            <Insets bottom="18.0" left="20.0" right="20.0" top="18.0" />
         </padding>
         <children>
            <VBox fx:id="leftColumn" spacing="14.0" HBox.hgrow="ALWAYS">
               <children>
                  <Label fx:id="questionTitleLabel" text="Loading question..." />
                  <HBox spacing="8.0">
                     <children>
                        <Label fx:id="qTypeLabel" text="" />
                        <Label fx:id="qTagLabel" text="" />
                        <Label fx:id="difficultyLabel" text="" />
                     </children>
                  </HBox>
                  <VBox fx:id="problemCard" spacing="10.0">
                     <padding>
                        <Insets bottom="14.0" left="14.0" right="14.0" top="14.0" />
                     </padding>
                     <children>
                        <HBox alignment="CENTER_LEFT" spacing="8.0">
                           <children>
                              <Label text="Problem Description" />
                              <Region HBox.hgrow="ALWAYS" />
                              <Button fx:id="rate_question_btn" mnemonicParsing="false" onAction="#rateQuestion" text="Rate" />
                              <Label fx:id="questionRatingLabel" text="-" />
                           </children>
                        </HBox>
                        <Label fx:id="q_desc_label" text="" wrapText="true" />
                        <Label text="Examples" />
                        <VBox fx:id="examplesContainer" spacing="10.0">
                           <children>
                              <Label text="No examples available." />
                           </children>
                        </VBox>
                     </children>
                  </VBox>
                  <VBox fx:id="hintsCard" spacing="8.0">
                     <padding>
                        <Insets bottom="14.0" left="14.0" right="14.0" top="14.0" />
                     </padding>
                     <children>
                        <Label text="Hints" />
                        <VBox fx:id="hintsContainer" spacing="6.0" />
                     </children>
                  </VBox>
               </children>
            </VBox>
            <VBox fx:id="rightColumn" prefWidth="560.0" spacing="14.0">
               <children>
                  <VBox fx:id="responseCard" spacing="10.0">
                     <padding>
                        <Insets bottom="14.0" left="14.0" right="14.0" top="14.0" />
                     </padding>
                     <children>
                        <Label text="Your Response" />
                        <TextArea fx:id="responseArea" prefHeight="170.0" promptText="Type your answer here" wrapText="true" />
                        <HBox spacing="8.0">
                           <children>
                              <Button fx:id="add_sec_btn" mnemonicParsing="false" onAction="#addSectionDraft" text="+ Add Section" />
                              <Button fx:id="add_t_btn" mnemonicParsing="false" onAction="#addTagDraft" text="+ Add Tag" />
                              <Region HBox.hgrow="ALWAYS" />
                              <Button fx:id="sub_com_btn" mnemonicParsing="false" onAction="#submitComment" text="Submit Comment" />
                           </children>
                        </HBox>
                        <Label fx:id="replyingToLabel" text="" visible="false" />
                        <Label text="Draft Sections" />
                        <VBox fx:id="draftSectionsContainer" spacing="6.0" />
                        <Label text="Draft Tags" />
                        <VBox fx:id="draftTagsContainer" spacing="6.0" />
                     </children>
                  </VBox>
                  <VBox fx:id="commentsCard" spacing="10.0" VBox.vgrow="ALWAYS">
                     <padding>
                        <Insets bottom="14.0" left="14.0" right="14.0" top="14.0" />
                     </padding>
                     <children>
                        <HBox alignment="CENTER_LEFT">
                           <children>
                              <Label text="Comments" />
                              <Region HBox.hgrow="ALWAYS" />
                              <ComboBox fx:id="commentFilterBox" onAction="#onCommentFilterChanged" prefWidth="170.0" promptText="Comment Filters" />
                           </children>
                        </HBox>
                        <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS">
                           <content>
                              <VBox fx:id="commentsContainer" spacing="12.0">
                                 <padding>
                                    <Insets bottom="8.0" left="4.0" right="4.0" top="8.0" />
                                 </padding>
                              </VBox>
                           </content>
                        </ScrollPane>
                     </children>
                  </VBox>
               </children>
            </VBox>
         </children>
      </HBox>
   </center>
   <stylesheets>
      <URL value="@styles.css" />
   </stylesheets>
</BorderPane>
