<BorderPane prefHeight="760.0" prefWidth="1200.0" stylesheets="@editorQstyles.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.controllers.EditorQController">
   <top>
      <HBox alignment="CENTER_LEFT" prefHeight="78.0" spacing="16.0" styleClass="dashboard-header" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="14.0" left="20.0" right="20.0" top="14.0" />
         </padding>
         <children>
            <Label styleClass="dashboard-brand-title" text="Corporate Code">
               <graphic>
                  <ImageView fitHeight="64.0" fitWidth="102.0">
                     <image>
                        <Image url="@images/corporatelogo-new.png" />
                     </image>
                  </ImageView>
               </graphic></Label>
            <Region HBox.hgrow="ALWAYS" />
            <Button fx:id="btn_home" mnemonicParsing="false" onAction="#goToDash" styleClass="dashboard-header-button">
               <graphic>
                  <ImageView fitHeight="40.0" fitWidth="39.0" pickOnBounds="true" preserveRatio="true" styleClass="dashboard-header-button">
                     <image>
                        <Image url="@images/Home.png" />
                     </image>
                  </ImageView>
               </graphic></Button>
            <Button fx:id="btn_search" mnemonicParsing="false" onAction="#goToSearch" styleClass="dashboard-header-button">
               <graphic>
                  <ImageView fitHeight="34.0" fitWidth="41.0" pickOnBounds="true" preserveRatio="true">
                     <image>
                        <Image url="@images/search_btn.png" />
                     </image>
                  </ImageView>
               </graphic></Button>
            <Button fx:id="btn_logout" mnemonicParsing="false" onAction="#logout" styleClass="dashboard-header-button">
               <graphic>
                  <ImageView fitHeight="33.0" fitWidth="61.0" pickOnBounds="true" preserveRatio="true" styleClass="dashboard-header-button">
                     <image>
                        <Image url="@images/Log%20out.png" />
                     </image>
                  </ImageView>
               </graphic></Button>
            <Button fx:id="btn_settings" mnemonicParsing="false" onAction="#goToSettings" styleClass="dashboard-header-button">
               <graphic>
                  <ImageView fitHeight="41.0" fitWidth="49.0" pickOnBounds="true" preserveRatio="true" styleClass="dashboard-header-button">
                     <image>
                        <Image url="@images/Settings.png" />
                     </image>
                  </ImageView>
               </graphic></Button>
         </children>
      </HBox>
   </top>
