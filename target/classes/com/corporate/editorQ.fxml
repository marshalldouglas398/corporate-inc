      <VBox spacing="16.0" styleClass="dashboard-page" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="18.0" left="20.0" right="20.0" top="18.0" />
         </padding>
         <children>
            <Label fx:id="welcomeMessage" styleClass="dashboard-welcome-message" text="Welcome back, Editor!" />
            <Label fx:id="text_dash_date" styleClass="dashboard-date" text="Thursday, April 2, 2026" />
            <HBox alignment="CENTER_LEFT" spacing="12.0">
               <children>
                  <Label styleClass="editor-q-toolbar-label" text="Questions Made:" />
                  <Region HBox.hgrow="ALWAYS" />
                  <Button mnemonicParsing="false" styleClass="dashboard-button-challenge" text="Add Question" />
               </children>
            </HBox>
            <VBox styleClass="editor-q-grid-wrap" VBox.vgrow="ALWAYS">
               <children>
                  <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS">
