                                          <Label styleClass="editor-q-card-rating" text="Rating: 4.5" />
                                       </children>
                                    </HBox>
                                    <Label styleClass="editor-q-card-body" text="Given an array of integers and a target value, find the indices of two numbers that add up to the target." wrapText="true" />
