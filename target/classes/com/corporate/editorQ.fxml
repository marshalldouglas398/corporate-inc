                              <VBox maxWidth="360.0" minWidth="360.0" prefWidth="360.0" spacing="10.0" styleClass="editor-q-card">
                                 <padding>
                                    <Insets bottom="12.0" left="12.0" right="12.0" top="12.0" />
                                 </padding>
                                 <children>
                                    <Label styleClass="editor-q-card-title" text="Two Sum" />
                                    <HBox alignment="CENTER_LEFT" spacing="8.0">
                                       <children>
                                          <Label styleClass="editor-q-card-tag" text="tag" />
                                          <Region HBox.hgrow="ALWAYS" />
                                          <Label styleClass="editor-q-card-rating" text="Rating: 4.5" />
                                       </children>
                                    </HBox>
                                    <Label styleClass="editor-q-card-body" text="Given an array of integers and a target value, find the indices of two numbers that add up to the target." wrapText="true" />
                                    <HBox alignment="CENTER">
                                       <children>
                                          <Button mnemonicParsing="false" styleClass="dashboard-start-button" text="Edit" />
                                       </children>
                                    </HBox>
                                 </children>
                              </VBox>
