                        <Font size="20.0" />
                     </font>
                  </Text>
               </children>
            </AnchorPane>
            <AnchorPane prefHeight="200.0" prefWidth="200.0">
               <children>
                  <AnchorPane maxWidth="443.0" prefHeight="285.0" prefWidth="443.0" styleClass="dashboard-student-challenge-box">
                     <children>
                        <Text fill="#fff8f8" layoutX="31.0" layoutY="47.0" strokeType="OUTSIDE" strokeWidth="0.0" styleClass="dashboard-challenge-header" text="Today's Challenge">
                           <font>
                              <Font size="20.0" />
                           </font>
                        </Text>
                        <Line endX="472.66668701171875" fill="WHITE" layoutX="145.0" layoutY="62.0" startX="-114.0" startY="-5.96484375" stroke="WHITE" />
                        <Text fx:id="chll_title" fill="WHITE" layoutX="38.0" layoutY="95.0" strokeType="OUTSIDE" strokeWidth="0.0" styleClass="dashboard-challege-question-title" text="Question Title">
                           <font>
                              <Font size="20.0" />
                           </font>
                        </Text>
                        <Text fx:id="chll_desc" fill="WHITE" layoutX="54.0" layoutY="140.0" strokeType="OUTSIDE" strokeWidth="0.0" styleClass="dashboard-challenge-question-description" text="description" wrappingWidth="340.3072204589844">
                           <font>
                              <Font size="18.0" />
                           </font>
                        </Text>
                        <Text fx:id="chll_type" fill="WHITE" layoutX="41.0" layoutY="247.0" strokeType="OUTSIDE" strokeWidth="0.0" styleClass="dashboard-challenge-question-description" text="QType">
                           <font>
                              <Font size="18.0" />
                           </font>
                        </Text>
                        <Text fx:id="chll_diff" fill="WHITE" layoutX="167.0" layoutY="245.0" strokeType="OUTSIDE" strokeWidth="0.0" styleClass="dashboard-challenge-question-description" text="Difficulty">
                           <font>
                              <Font size="18.0" />
                           </font>
                        </Text>
                        <Button fx:id="chll_btn" layoutX="61.0" layoutY="267.0" mnemonicParsing="false" onAction="#goToChallenge" prefHeight="55.0" prefWidth="567.0" styleClass="dashboard-button-challenge" text="Start Challenge" />
                     </children>
                  </AnchorPane>
               </children>
            </AnchorPane>
            <AnchorPane prefHeight="200.0" prefWidth="200.0" />
         </children>
      </VBox>
   </center>
   <opaqueInsets>
      <Insets />
   </opaqueInsets>
</BorderPane>
