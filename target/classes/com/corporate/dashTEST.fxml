<BorderPane prefHeight="640.0" prefWidth="980.0" styleClass="login-page" stylesheets="@teststyles.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.controllers.LoginController">
   <top>
      <HBox alignment="CENTER_LEFT" spacing="14.0" styleClass="login-header-bar">
         <children>
            <Button fx:id="btn_back" mnemonicParsing="false" onAction="#back" styleClass="login-link" text="&lt;" />
            <VBox prefHeight="54.0" prefWidth="208.0" spacing="1.0">
               <children>
                  <Label prefHeight="73.0" prefWidth="208.0" styleClass="login-brand-title" text="Corporate Code" />
               </children>
            </VBox>
            <AnchorPane prefHeight="71.0" prefWidth="685.0">
               <children>
                  <Button fx:id="stg_btn" layoutX="615.0" layoutY="5.0" mnemonicParsing="false" onAction="#goToSettings" pickOnBounds="false" prefHeight="53.0" prefWidth="63.0" styleClass="dashboard-header-button" stylesheets="@styles.css">
                     <graphic>
                        <ImageView fitHeight="43.0" fitWidth="38.0" pickOnBounds="true" preserveRatio="true" styleClass="dashboard-header-button">
                           <image>
                              <Image url="@images/Settings.png" />
                           </image>
                        </ImageView>
                     </graphic>
                  </Button>
                  <Button fx:id="btn_search" layoutX="507.0" layoutY="12.0" mnemonicParsing="false" onAction="#goToSearch">
                     <graphic>
                        <ImageView fitHeight="34.0" fitWidth="41.0" pickOnBounds="true" preserveRatio="true">
                           <image>
                              <Image url="@images/search_btn.png" />
                           </image>
                        </ImageView>
                     </graphic>
                  </Button>
                  <Button fx:id="btn_logout" layoutX="563.0" layoutY="6.0" mnemonicParsing="false" onAction="#logout" pickOnBounds="false" prefHeight="60.0" prefWidth="65.0" styleClass="dashboard-header-button" stylesheets="@styles.css">
                     <graphic>
                        <ImageView fitHeight="39.0" fitWidth="36.0" pickOnBounds="true" preserveRatio="true" styleClass="dashboard-header-button">
                           <image>
                              <Image url="@images/Log%20out.png" />
                           </image>
                        </ImageView>
                     </graphic>
                  </Button>
                  <Button fx:id="h_btn" layoutX="432.0" layoutY="6.0" mnemonicParsing="false" prefHeight="60.0" prefWidth="74.0" styleClass="dashboard-header-button" stylesheets="@styles.css">
                     <graphic>
                        <ImageView fitHeight="36.0" fitWidth="48.0" pickOnBounds="true" preserveRatio="true" styleClass="dashboard-header-button">
                           <image>
                              <Image url="@images/Home.png" />
                           </image>
                        </ImageView>
                     </graphic>
                  </Button>
               </children>
            </AnchorPane>
         </children>
      </HBox>
   </top>
   <center>
      <VBox alignment="CENTER" styleClass="login-content">
         <padding>
            <Insets bottom="24.0" left="16.0" right="16.0" top="24.0" />
         </padding>
         <children>
            <AnchorPane prefHeight="98.0" prefWidth="940.0">
               <children>
                  <Text fx:id="welcomeMessage" layoutX="49.0" layoutY="51.0" strokeType="OUTSIDE" strokeWidth="0.0" styleClass="dashboard-header" text="Welcome, user!" wrappingWidth="449.3070068359375">
                     <font>
                        <Font size="31.0" />
                     </font>
                  </Text>
                  <Text fx:id="date_text" layoutX="54.0" layoutY="80.0" strokeType="OUTSIDE" strokeWidth="0.0" styleClass="dashboard-date" text="Insert Date Logic Here" wrappingWidth="439.01666259765625">
