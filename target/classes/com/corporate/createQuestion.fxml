<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="760.0" prefWidth="1200.0" styleClass="create-question-page" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.controllers.CreateQuestionController">
   <top>
      <HBox alignment="CENTER_LEFT" prefHeight="78.0" spacing="14.0" styleClass="create-question-header-bar" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="14.0" left="20.0" right="20.0" top="14.0" />
         </padding>
         <children>
            <Label styleClass="create-question-brand-title" text="Corporate Code" />
            <Region HBox.hgrow="ALWAYS" />
            <Button fx:id="backButton" mnemonicParsing="false" onAction="#back" styleClass="create-question-header-button" text="Back" />
         </children>
      </HBox>
   </top>
   <center>
      <VBox fx:id="createQuestionContent" spacing="14.0" styleClass="create-question-content">
         <padding>
            <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
         </padding>
         <children>
            <Label fx:id="pageTitleLabel" styleClass="create-question-title" text="Create Question" />
            <VBox fx:id="metadataSection" spacing="10.0" styleClass="create-question-card">
               <padding>
                  <Insets bottom="14.0" left="14.0" right="14.0" top="14.0" />
               </padding>
               <children>
                  <Label styleClass="create-question-label" text="Question Metadata: please only add one for each" />
                  <HBox spacing="10.0">
                     <children>
                        <VBox spacing="6.0" HBox.hgrow="ALWAYS">
                           <children>
                              <Label styleClass="create-question-label" text="Title" />
                              <TextField fx:id="questionTitleField" promptText="Enter question title" styleClass="create-question-input" />
                           </children>
                        </VBox>
                        <VBox prefWidth="220.0" spacing="6.0">
                           <children>
                              <Label styleClass="create-question-label" text="Difficulty" />
                              <TextField fx:id="questionDifficultyField" promptText="EASY / MEDIUM / HARD" styleClass="create-question-input" />
                           </children>
                        </VBox>
                     </children>
                  </HBox>
                  <HBox spacing="10.0">
                     <children>
                        <VBox spacing="6.0" HBox.hgrow="ALWAYS">
                           <children>
                              <Label styleClass="create-question-label" text="Question Type" />
                              <TextField fx:id="questionTypeField" promptText="TECHNICAL / BEHAVIORAL / CONCEPTUAL" styleClass="create-question-input" />
                           </children>
                        </VBox>
                        <VBox spacing="6.0" HBox.hgrow="ALWAYS">
                           <children>
                              <Label styleClass="create-question-label" text="Tags" />
                              <TextField fx:id="questionTagsField" promptText="Comma-separated QuestionTag values" styleClass="create-question-input" />
                           </children>
                        </VBox>
                     </children>
                  </HBox>
                  <HBox spacing="10.0">
                     <children>
                        <VBox spacing="6.0" HBox.hgrow="ALWAYS">
                           <children>
                              <Label styleClass="create-question-label" text="Discipline" />
                              <TextField fx:id="questionDisciplinesField" promptText="COMPSCI, COMPENG, CYBERSEC, DATASCI" styleClass="create-question-input" />
                           </children>
                        </VBox>
                        <VBox spacing="6.0" HBox.hgrow="ALWAYS">
                           <children>
                              <Label styleClass="create-question-label" text="Course" />
                              <TextField fx:id="questionCoursesField" promptText="CSCE145, CSCE146, CSCE240, CSCE247, CSCE350" styleClass="create-question-input" />
                           </children>
                        </VBox>
                     </children>
                  </HBox>
                  <HBox alignment="CENTER_LEFT" spacing="10.0">
                     <children>
                        <CheckBox fx:id="interviewModeCheckBox" mnemonicParsing="false" styleClass="create-question-check-box" text="Interview Mode" />
                        <Label styleClass="create-question-label" text="Time Limit (minutes)" />
                        <TextField fx:id="interviewTimeField" prefWidth="180.0" promptText="e.g. 45" styleClass="create-question-input" />
                     </children>
                  </HBox>
               </children>
            </VBox>
            <VBox fx:id="statementSection" spacing="8.0" styleClass="create-question-card">
               <padding>
                  <Insets bottom="14.0" left="14.0" right="14.0" top="14.0" />
               </padding>
               <children>
                  <Label styleClass="create-question-label" text="Problem Statement" />
                  <TextArea fx:id="questionDescriptionArea" prefHeight="170.0" promptText="Describe the question prompt and constraints..." styleClass="create-question-textarea" wrapText="true" />
               </children>
            </VBox>
            <VBox fx:id="hintsSection" spacing="10.0" styleClass="create-question-card">
               <padding>
                  <Insets bottom="14.0" left="14.0" right="14.0" top="14.0" />
               </padding>
               <children>
                  <Label styleClass="create-question-label" text="Hints" />
                  <TextField fx:id="questionHintOneField" promptText="Hint 1" styleClass="create-question-input" />
                  <TextField fx:id="questionHintTwoField" promptText="Hint 2" styleClass="create-question-input" />
                  <TextField fx:id="questionHintThreeField" promptText="Hint 3" styleClass="create-question-input" />
               </children>
            </VBox>
            <VBox fx:id="sectionsBuilderSection" spacing="10.0" styleClass="create-question-card">
               <padding>
                  <Insets bottom="14.0" left="14.0" right="14.0" top="14.0" />
               </padding>
               <children>
                  <HBox alignment="CENTER_LEFT" spacing="10.0">
                     <children>
                        <Label styleClass="create-question-label" text="Sections" />
                        <Region HBox.hgrow="ALWAYS" />
                     </children>
                  </HBox>
                  <Label fx:id="sectionInstructionsLabel" styleClass="create-question-note" text="Use Add Section to add additional section blocks." wrapText="true" />
                  <VBox fx:id="sectionsContainer" spacing="12.0">
                     <children>
                        <VBox fx:id="sectionCardOne" spacing="8.0" styleClass="create-question-inner-card">
                           <padding>
                              <Insets bottom="12.0" left="12.0" right="12.0" top="12.0" />
                           </padding>
                           <children>
                              <Label styleClass="create-question-label" text="Section" />
                              <TextField fx:id="sectionOneTitleField" promptText="Section title" styleClass="create-question-input" />
                              <TextArea fx:id="sectionOneDescriptionArea" prefHeight="100.0" promptText="Section description" styleClass="create-question-textarea" wrapText="true" />
                              <TextField fx:id="sectionOneFileField" promptText="Attached file name/path (optional)" styleClass="create-question-input" />
                              <TextArea fx:id="sectionOneCodeArea" prefHeight="120.0" promptText="Code/content for this section" styleClass="create-question-textarea" wrapText="true" />
                           </children>
                        </VBox>
                        <VBox fx:id="sectionCardTwoPlaceholder" spacing="8.0" styleClass="create-question-inner-card">
                           <padding>
                              <Insets bottom="12.0" left="12.0" right="12.0" top="12.0" />
                           </padding>
                        </VBox>
                     </children>
                  </VBox>
               </children>
            </VBox>
            <HBox fx:id="actionsRow" alignment="CENTER_RIGHT" spacing="10.0" styleClass="create-question-actions-row">
               <children>
                  <Region HBox.hgrow="ALWAYS" />
                  <Button fx:id="addSectionButton" mnemonicParsing="false" styleClass="create-question-button" text="+ Add Section" />
                  <Button fx:id="cancelButton" mnemonicParsing="false" styleClass="create-question-button" text="Cancel" />
                  <Button fx:id="saveButton" mnemonicParsing="false" styleClass="create-question-button" text="Save Question" />
               </children>
            </HBox>
         </children>
      </VBox>
   </center>
   <stylesheets>
      <URL value="@styles.css" />
   </stylesheets>
</BorderPane>
